data/raw/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Jekyll
site/_site/
site/.jekyll-cache/
.bundle/
vendor/

# Local output
camps.ics
.DS_Store
