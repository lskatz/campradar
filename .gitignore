# ---------------------------------------------------------------------------
# Anything that could contain information about a child. See docs/privacy.md.
# These patterns come first so they are impossible to miss when auditing.
# ---------------------------------------------------------------------------
config/kids.local.yaml
config/*.local.yaml
*.private.json

# Fetched pages. Regenerable, large, and occasionally contains provider
# contact details we have no business republishing.
data/raw/

# Run log. Previously committed, which was a mistake: httpx logs full request
# URLs, and any API key travelling in a query string would land in git history
# on a public repo. Redaction in campradar/redact.py is the primary defence;
# not committing the log is the second one. Both, because a leaked credential
# cannot be un-pushed.
data/refresh.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Jekyll
site/_site/
site/.jekyll-cache/
.bundle/
vendor/

# Local output
camps.ics
.DS_Store
