# ---------------------------------------------------------------------------
# Privacy first, so it is impossible to miss when auditing.
#
# Nothing in this repository holds information about a child, and no code here
# reads these files. The patterns are a guardrail against that changing by
# accident — if a local override file ever appears, it stays local.
# ---------------------------------------------------------------------------
config/*.local.yaml
*.private.json

# ---------------------------------------------------------------------------
# Fetched pages. Regenerable, large, and occasionally carry provider contact
# details we have no business republishing.
#
# NOTE: data/camps.json is deliberately NOT ignored. It carries first_seen
# between runs, so ignoring it would re-report every camp as new on every
# fresh clone.
# ---------------------------------------------------------------------------
data/cache/

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- editors / os ----------------------------------------------------------
.DS_Store
